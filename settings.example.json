{
  "version": 1,
  "general": {
    "ui_language": "tr",
    "start_with_windows": false,
    "minimize_to_tray": true,
    "notify_on_done": true,
    "auto_detect_source": true,
    "keep_original_on_failure": true
  },
  "languages": {
    "preferred_target": "en",
    "alt_b_target": "",
    "alt_n_target": "",
    "source": "auto",
    "prompt": "",
    "context_enabled": true,
    "context_max_messages": 5,
    "context_ttl_minutes": 30
  },
  "ocr": {
    "engine": "auto",
    "fallback_to_ai": true,
    "copy_to_clipboard": false,
    "show_notification": true,
    "target_language": ""
  },
  "providers": {
    "active": "translateai",
    "auto_fallback": false,
    "fallback_order": ["translateai", "lmstudio", "local_llm", "gemini", "google"],
    "timeout_seconds": 30,
    "translateai": {
      "model": "",
      "n_ctx": 4096,
      "max_n_ctx": 10000,
      "auto_expand_ctx": true,
      "dynamic_context_trim": true,
      "n_gpu_layers": -1
    },
    "local_llm": {
      "base_url": "http://localhost:11434/v1",
      "model": ""
    },
    "lmstudio": {
      "base_url": "http://localhost:1234/v1",
      "model": ""
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-3.8-flash"
    },
    "google": {
      "use_cloud_api": false
    }
  },
  "hotkeys": {
    "enabled": true,
    "alt_b": "Alt+B",
    "alt_n": "Alt+N",
    "alt_m": "Alt+M",
    "alt_v": "Alt+V",
    "alt_c": "Alt+C",
    "alt_o": "Alt+O"
  },
  "privacy": {
    "history_enabled": false,
    "cache_enabled": true
  }
}
